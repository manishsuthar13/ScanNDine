# Server
PORT=5000
MONGO_URI=mongodb://localhost:27017/scan-n-dine
# Frontend origin: used for CORS, QR code links and password-reset links
BASE_URL=http://localhost:3000
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Seeded superadmin (created on first start if none exists)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Password-reset email. Leave SMTP_HOST empty in development to log the link instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Scan & Dine <no-reply@example.com>"

# Cloudinary (menu item images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: separate database for `npm test` (its name must contain "test"; it is wiped on every run)
# MONGO_URI_TEST=mongodb://localhost:27017/scanndine-test
